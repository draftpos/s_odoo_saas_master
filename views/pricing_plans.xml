<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="pricing_plans" name="Pricing Plans">
    <t t-call="website.layout">
      <t t-set="additional_title">SaaS Pricing Plans</t>
      <div id="wrap" class="js_sale bg-light py-5" style="font-family: 'Outfit', sans-serif;">
        <!-- CSS & Fonts -->
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&amp;display=swap');
          
          .pricing-header {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            border-radius: 16px;
            color: white;
            padding: 60px 20px;
            margin-bottom: 40px;
          }
          
          .plan-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 20px;
            transition: all 0.3s ease-in-out;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
          }
          
          .plan-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(124, 58, 237, 0.15);
            border-color: rgba(124, 58, 237, 0.3);
          }
          
          .plan-badge {
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            color: white;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 50px;
            position: absolute;
            top: 20px;
            right: 20px;
          }
          
          .toggle-container {
            background: #E5E7EB;
            border-radius: 50px;
            padding: 4px;
            display: inline-flex;
            margin-bottom: 40px;
          }
          
          .toggle-btn {
            border: none;
            background: transparent;
            padding: 8px 24px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
          }
          
          .toggle-btn.active {
            background: white;
            color: #4F46E5;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
          }
          
          .btn-subscribe {
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px 24px;
            font-weight: 600;
            transition: all 0.2s;
            text-align: center;
          }
          
          .btn-subscribe:hover {
            opacity: 0.95;
            transform: scale(1.02);
            color: white;
          }
        </style>

        <div class="container">
          <!-- Page Header -->
          <div class="pricing-header text-center">
            <h1 class="display-4 fw-bold">SaaS Subscription Plans</h1>
            <p class="lead">Unlock the full power of Havano ERP with our flexible plans.</p>
            <t t-if="instance">
              <div class="alert alert-info d-inline-block mt-2" role="alert">
                Upgrading / Downgrading for instance: <strong><t t-esc="instance.name"/></strong>
              </div>
            </t>
          </div>

          <!-- Billing Toggle -->
          <div class="text-center">
            <div class="toggle-container">
              <button type="button" class="toggle-btn active" id="btn_yearly">Yearly (Save)</button>
              <button type="button" class="toggle-btn" id="btn_monthly">Monthly</button>
            </div>
          </div>

          <!-- Plans Grid -->
          <div class="row justify-content-center align-items-stretch">
            <t t-foreach="plans" t-as="plan">
              <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card plan-card h-100 p-4 position-relative">
                  <!-- Optional Badge for Popularity/First Plan -->
                  <div t-if="plan_index == 1" class="plan-badge">Popular</div>
                  
                  <div>
                    <h3 class="fw-bold text-dark mt-2"><t t-esc="plan['name']"/></h3>
                    <div class="my-4">
                      <!-- Price display switching via JS -->
                      <h2 class="display-5 fw-bold text-primary price-yearly">
                        <t t-esc="plan['yearly_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <span class="fs-6 text-muted font-normal">/ month</span>
                      </h2>
                      <h2 class="display-5 fw-bold text-primary price-monthly d-none">
                        <t t-esc="plan['monthly_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        <span class="fs-6 text-muted font-normal">/ month</span>
                      </h2>
                      <p class="text-muted small price-yearly">Billed annually</p>
                      <p class="text-muted small price-monthly d-none">Billed monthly</p>
                    </div>

                    <!-- Features -->
                    <ul class="list-unstyled mb-4">
                      <li class="mb-2">
                        <i class="fa fa-check text-success mr-2"/>
                        POS Terminals: <strong><t t-esc="plan['limit_pos_terminals']"/></strong>
                      </li>
                      <li class="mb-2">
                        <i class="fa fa-check text-success mr-2"/>
                        Active Users: <strong><t t-esc="plan['limit_users']"/></strong>
                      </li>
                      <t t-if="plan['description']">
                        <div class="mt-3 text-muted">
                          <t t-out="plan['description']"/>
                        </div>
                      </t>
                    </ul>
                  </div>

                  <!-- Checkout/Action Button -->
                  <div class="mt-auto">
                    <t t-if="instance">
                      <!-- Direct upgrade submit if existing instance -->
                      <form action="/pricing-plans/checkout" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="plan_id" t-att-value="plan['id']"/>
                        <input type="hidden" name="instance_id" t-att-value="instance.id"/>
                        <input type="hidden" name="price_by" value="yearly" class="price-by-input"/>
                        <button type="submit" class="btn btn-subscribe w-100">Upgrade Plan</button>
                      </form>
                    </t>
                    <t t-else="">
                      <!-- Open modal for new database creation setup -->
                      <button class="btn btn-subscribe w-100 btn-select-plan" 
                              t-att-data-plan-id="plan['id']" 
                              t-att-data-plan-name="plan['name']">
                        Select Plan
                      </button>
                    </t>
                  </div>
                </div>
              </div>
            </t>
          </div>
        </div>
      </div>

      <!-- Creation Setup Modal -->
      <div class="modal fade" id="setupModal" tabindex="-1" aria-labelledby="setupModalLabel" aria-hidden="true" style="font-family: 'Outfit', sans-serif;">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content border-0" style="border-radius: 20px;">
            <div class="modal-header bg-primary text-white border-0" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
              <h5 class="modal-title fw-bold" id="setupModalLabel">Set up SaaS Site</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/pricing-plans/checkout" method="post" id="plan_checkout_form">
              <div class="modal-body p-4">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="plan_id" id="modal_plan_id"/>
                <input type="hidden" name="price_by" value="yearly" id="modal_price_by"/>

                <!-- Domain Name picking -->
                <div class="mb-4">
                  <label class="form-label fw-bold">Pick your Subdomain</label>
                  <div class="d-flex align-items-center">
                    <input class="form-control border pr-2" id="modal_sub_domain" name="sub_domain"
                           type="text" required="required" placeholder="your-subdomain" style="max-width: 60%;"/>
                    <span class="px-2">.</span>
                    <select class="form-control border" id="modal_domain" name="domain" style="max-width: 35%;">
                      <t t-foreach="domains" t-as="domain">
                        <option t-att-value="domain.id"><t t-esc="domain.name"/></option>
                      </t>
                    </select>
                  </div>
                  <div class="text-danger small mt-1" id="domain_error_msg"></div>
                </div>

                <!-- Restore Backup template selector -->
                <div class="mb-4">
                  <label class="form-label fw-bold">Installation Method</label>
                  <div>
                    <div class="form-check form-check-inline mb-2">
                      <input class="form-check-input creation_mode_radio" type="radio" name="creation_mode" id="modal_mode_scratch" value="scratch"/>
                      <label class="form-check-label ml-1" for="modal_mode_scratch">Create from Scratch</label>
                    </div>
                    <br/>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input creation_mode_radio" type="radio" name="creation_mode" id="modal_mode_backup" value="backup_restore" checked="checked"/>
                      <label class="form-check-label ml-1" for="modal_mode_backup">Restore from Backup (Template)</label>
                    </div>
                  </div>
                  <div class="mt-3" id="modal_template_selection_div">
                    <label for="modal_template_instance_id" class="form-label small text-muted">Select Template Site:</label>
                    <select class="form-control border" id="modal_template_instance_id" name="template_instance_id">
                      <t t-foreach="templates" t-as="tmpl">
                        <option t-att-value="tmpl.id" t-att-selected="tmpl.id == default_template_id"><t t-esc="tmpl.name"/></option>
                      </t>
                    </select>
                  </div>
                </div>

              </div>
              <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-secondary border-0" data-bs-dismiss="modal" style="border-radius: 10px;">Cancel</button>
                <button type="submit" class="btn btn-primary" id="btn_modal_checkout_submit" style="border-radius: 10px; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); border: none;">Proceed to Checkout</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Toggle Pricing Script -->
      <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function() {
          const btnYearly = document.getElementById('btn_yearly');
          const btnMonthly = document.getElementById('btn_monthly');
          const yearlyPrices = document.querySelectorAll('.price-yearly');
          const monthlyPrices = document.querySelectorAll('.price-monthly');
          const priceByInputs = document.querySelectorAll('.price-by-input');
          const modalPriceBy = document.getElementById('modal_price_by');

          function togglePricing(mode) {
            if (mode === 'yearly') {
              btnYearly.classList.add('active');
              btnMonthly.classList.remove('active');
              yearlyPrices.forEach(p => p.classList.remove('d-none'));
              monthlyPrices.forEach(p => p.classList.add('d-none'));
              priceByInputs.forEach(i => i.value = 'yearly');
              if (modalPriceBy) modalPriceBy.value = 'yearly';
            } else {
              btnYearly.classList.remove('active');
              btnMonthly.classList.add('active');
              yearlyPrices.forEach(p => p.classList.add('d-none'));
              monthlyPrices.forEach(p => p.classList.remove('d-none'));
              priceByInputs.forEach(i => i.value = 'monthly');
              if (modalPriceBy) modalPriceBy.value = 'monthly';
            }
          }

          if (btnYearly &amp;&amp; btnMonthly) {
            btnYearly.addEventListener('click', () => togglePricing('yearly'));
            btnMonthly.addEventListener('click', () => togglePricing('monthly'));
          }

          // Modal behavior for selecting plans
          const setupModalElement = document.getElementById('setupModal');
          const setupModal = setupModalElement ? new bootstrap.Modal(setupModalElement) : null;
          const selectButtons = document.querySelectorAll('.btn-select-plan');
          const modalPlanIdInput = document.getElementById('modal_plan_id');
          const modalTitleSpan = document.getElementById('setupModalLabel');

          selectButtons.forEach(btn => {
            btn.addEventListener('click', function() {
              const planId = this.getAttribute('data-plan-id');
              const planName = this.getAttribute('data-plan-name');
              if (modalPlanIdInput) modalPlanIdInput.value = planId;
              if (modalTitleSpan) modalTitleSpan.textContent = 'Set up ' + planName + ' Plan';
              if (setupModal) setupModal.show();
            });
          });

          // Installation mode toggle in modal
          const modeScratch = document.getElementById('modal_mode_scratch');
          const modeBackup = document.getElementById('modal_mode_backup');
          const templateDiv = document.getElementById('modal_template_selection_div');

          function toggleTemplateSelection() {
            if (templateDiv) {
              if (modeBackup &amp;&amp; modeBackup.checked) {
                templateDiv.style.display = 'block';
              } else {
                templateDiv.style.display = 'none';
              }
            }
          }

          if (modeScratch &amp;&amp; modeBackup) {
            modeScratch.addEventListener('change', toggleTemplateSelection);
            modeBackup.addEventListener('change', toggleTemplateSelection);
            toggleTemplateSelection();
          }

          // Subdomain verification
          const subDomainInput = document.getElementById('modal_sub_domain');
          const domainSelect = document.getElementById('modal_domain');
          const errorMsgDiv = document.getElementById('domain_error_msg');
          const submitBtn = document.getElementById('btn_modal_checkout_submit');

          if (subDomainInput) {
            subDomainInput.addEventListener('blur', function() {
              const subdomain = this.value.trim();
              const domainId = domainSelect ? domainSelect.value : null;
              if (!subdomain) return;

              fetch('/pricing/check-domain', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  jsonrpc: '2.0',
                  params: {
                    sub_domain: subdomain,
                    domain_id: parseInt(domainId)
                  }
                })
              })
              .then(res => res.json())
              .then(data => {
                const result = data.result || {};
                if (result.success === false) {
                  if (errorMsgDiv) errorMsgDiv.textContent = result.error || 'Subdomain is not available';
                  if (submitBtn) submitBtn.disabled = true;
                } else {
                  if (errorMsgDiv) errorMsgDiv.textContent = '';
                  if (submitBtn) submitBtn.disabled = false;
                }
              })
              .catch(err => {
                console.error('Domain check failed:', err);
              });
            });
          }
        });
      </script>
    </t>
  </template>

</odoo>
