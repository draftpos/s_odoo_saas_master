<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="pricing" name="Pricing">
    <t t-call="website.layout">
      <t t-set="additional_title">Pricing</t>
      <div id="wrap" class="js_sale">
        <section class="s_banner o_gradient js_top_banner text-center bg-primary">
          <h1 class="display-2 text-white py-5 mb-5">Pricing</h1>
        </section>
        <section class="openerp_enterprise_pricing position-relative">
          <form class="openerp_enterprise_pricing_form container pt-4" method="post" action="/pricing/checkout">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="checkbox" name="is_trial" class="openerp_enterprise_pricing_app_trial d-none"/>
            <input type="checkbox" name="buy_now_from_pricing" class="d-none" checked="1"/>
            <div class="d-none openerp_enterprise_pricing_pricelist" t-attf-data-pricelist="{{ pricelist.id }}"></div>
            <input type="hidden" name="instance_id" t-att-value="instance.id" t-if="instance"/>
            
            <t t-if="instance">
              <div class="alert alert-info py-3 text-center mb-4" role="alert">
                Upgrading / Downgrading for instance: <strong><t t-esc="instance.name"/></strong>
              </div>
            </t>

            <div class="row">
              <div class="col-12 col-md-8 col-lg-8">
                <!-- Hide Domain and Installation Method if upgrading an existing instance -->
                <t t-if="not instance">
                  <div class="openerp_enterprise_pricing_step mb-5">
                    <div class="openerp_enterprise_pricing_step_head">
                      <h3 class="mt16 mb8">Choose your
                        <b>Domain</b>
                      </h3>
                    </div>
                    <t t-call="s_odoo_saas_master.domain_picking"/>
                  </div>
                  <div class="openerp_enterprise_pricing_step mb-5" id="choose_creation_mode">
                    <div class="openerp_enterprise_pricing_step_head">
                      <h3 class="mt16 mb8">Choose installation
                        <b>Method</b>
                      </h3>
                    </div>
                    <div class="openerp_enterprise_pricing_step_body py-2">
                      <div class="d-flex align-items-center">
                        <div class="form-check form-check-inline mb-0 mr-4">
                          <input class="form-check-input creation_mode_radio" type="radio" name="creation_mode" id="creation_mode_scratch" value="scratch"/>
                          <label class="form-check-label ml-2" for="creation_mode_scratch">Create from Scratch</label>
                        </div>
                        <div class="form-check form-check-inline mb-0 ml-3">
                          <input class="form-check-input creation_mode_radio" type="radio" name="creation_mode" id="creation_mode_backup" value="backup_restore" checked="checked"/>
                          <label class="form-check-label ml-2" for="creation_mode_backup">Restore from Backup (Template)</label>
                        </div>
                      </div>
                      <div class="mt-3" id="template_selection_div">
                        <label for="template_instance_id" class="mr-2">Select Source Template Site:</label>
                        <select class="form-control border" id="template_instance_id" name="template_instance_id" style="max-width: 300px; display: inline-block;">
                          <t t-foreach="templates" t-as="tmpl">
                            <option t-att-value="tmpl.id" t-att-selected="tmpl.id == default_template_id"><t t-esc="tmpl.name"/></option>
                          </t>
                        </select>
                      </div>
                    </div>
                  </div>
                </t>

                <!-- Plan Selection Step -->
                <div class="openerp_enterprise_pricing_step mb-5" id="choose_your_plan">
                  <div class="openerp_enterprise_pricing_step_head">
                    <h3 class="mt16 mb8">Choose your
                      <b>Plan</b>
                    </h3>
                  </div>
                  <div class="openerp_enterprise_pricing_step_body">
                    <input type="hidden" name="plan_id" id="selected_plan_id" required="required"/>
                    <div class="row">
                      <t t-foreach="plans" t-as="plan">
                        <div class="col-12 col-sm-6 col-lg-6 mb-4">
                          <div class="card p-3 border openerp_enterprise_pricing_plan_card cursor-pointer" 
                               t-att-data-plan-id="plan['id']"
                               t-att-data-plan-name="plan['name']"
                               t-att-data-monthly-price="plan['monthly_price']"
                               t-att-data-yearly-price="plan['yearly_price']"
                               style="border-radius: 12px; transition: all 0.2s; cursor: pointer; border-width: 2px !important;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                              <h4 class="fw-bold mb-0 text-dark"><t t-esc="plan['name']"/></h4>
                              <span class="fa fa-check-circle text-success fs-4 d-none plan-check-icon"></span>
                            </div>
                            <div class="my-2">
                              <!-- Price Display switching -->
                              <h3 class="fw-bold text-primary mb-1 plan-price-monthly d-none">
                                <t t-esc="plan['monthly_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                <span class="fs-6 text-muted font-normal">/ month</span>
                              </h3>
                              <h3 class="fw-bold text-primary mb-1 plan-price-yearly">
                                <t t-esc="plan['yearly_price']/12" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                                <span class="fs-6 text-muted font-normal">/ month</span>
                              </h3>
                              <small class="text-muted billing-cycle-desc">Billed annually</small>
                            </div>
                            <ul class="list-unstyled my-2 small text-muted">
                              <li><i class="fa fa-check text-success mr-2"></i> POS Terminals: <strong><t t-esc="plan['limit_pos_terminals']"/></strong></li>
                              <li><i class="fa fa-check text-success mr-2"></i> Active Users: <strong><t t-esc="plan['limit_users']"/></strong></li>
                            </ul>
                            <t t-if="plan['description']">
                              <div class="small text-muted mt-2 border-top pt-2">
                                <t t-out="plan['description']"/>
                              </div>
                            </t>
                            <div class="mt-3">
                              <button type="button" class="btn btn-outline-primary btn-sm btn-select-plan-action w-100" style="border-radius: 6px;">Select Plan</button>
                            </div>
                          </div>
                        </div>
                      </t>
                    </div>
                  </div>
                </div>

              </div>
              <div class="col-12 col-md-4 col-lg-4 mt16" id="pricing_board">
              	<t t-call="s_odoo_saas_master.pricing_board"/>
              </div>
            </div>
          </form>
        </section>
      </div>
    </t>
  </template>

  <template id="domain_picking" name="Domain Picking">
    <div class="openerp_enterprise_pricing_step_body odoo_domain_picking d-flex align-items-stretch form-inline">
      <input class="openerp_enterprise_pricing_sub_domain form-control border text-right pr-2" id="sub_domain" name="sub_domain"
             type="text" required="required" style="max-width: 200px;" placeholder="your-subdomain"/>
      <label class="px-2">.</label>
      <select class="openerp_enterprise_pricing_domain form-control border" id="domain" name="domain">
        <t t-foreach="domains" t-as="domain">
          <option t-att-value="domain.id"><t t-esc="domain.name"/></option>
        </t>
      </select>
      <div class="odoo_domain_picking_error w-100"></div>
    </div>
  </template>

  <template id="pricing_board" name="Pricing Board">      
      <input type="radio" id="monthly_by" name="price_by" value="monthly" style="display:none;"/>
      <input type="radio" id="yearly_by" name="price_by" value="yearly" style="display:none;" checked="True"/>
      <div class="card border odoo_pricing_board position-sticky">
        <div class="card-header border-bottom bg-200 pt-0">
          <ul class="nav nav-tabs card-header-tabs" style="">
            <li class="nav-item" data-type="yearly">
              <a data-toggle="tab" data-bs-toggle="tab" href="#yearly" data-bs-target="#yearly" class="nav-link px-3 active border-top-0 rounded-0 fw_bold">Annually</a>
            </li>
            <li data-type="monthly" class="nav-item">
              <a data-toggle="tab" data-bs-toggle="tab" href="#monthly" data-bs-target="#monthly" class="nav-link px-2 border-top-0 rounded-0 fw_bold">Monthly</a>
            </li>
          </ul>
        </div>
        <div class="card-body">
          <div class="tab-content mb-3 mb-lg-0" style="">
            <div class="tab-pane fade tab-pane-monthly" id="monthly">
              <table id="o_monthly_table" class="table openerp_enterprise_pricing_table_recurrent">
                <tr>
                  <td class="border-top-0">
                    Plan: <b><span class="openerp_enterprise_pricing_plan_name">None</span></b>
                  </td>
                  <td class="text-right border-top-0">
                    <b class="openerp_enterprise_pricing_price_monthly">0.00</b>
                  </td>
                </tr>
              </table>
            </div>
            <div class="tab-pane fade tab-pane-yearly active show in" id="yearly">
              <table id="o_yearly_table" class="table mb-1">
                <tr>
                  <td class="border-top-0">
                    Plan: <b><span class="openerp_enterprise_pricing_plan_name">None</span></b>
                  </td>
                  <td class="text-right border-top-0">
                    <b class="openerp_enterprise_pricing_price_yearly">0.00</b>
                  </td>
                </tr>
                <tr class="active bg-200">
                  <td><b>Billed annually</b></td>
                  <td class="text-right">
                    <b class="openerp_enterprise_pricing_price_yearly_in_year">0.00</b>
                  </td>
                </tr>
              </table>
            </div>
          </div>
          <div class="openerp_enterprise_pricing_is_not_free_trial">
            <div class="d-grid gap-2 openerp_enterprise_pricing_form_button">
              <a class="btn btn-success btn-block openerp_enterprise_pricing_buy_now" href="#">SUBSCRIBE NOW</a>
              <div class="mt16 alert alert-danger openerp_enterprise_pricing_error_no_apps d-none">Please select a plan.</div>
            </div>
          </div>
        </div>
      </div>
  </template>

</odoo>
